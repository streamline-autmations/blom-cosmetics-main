# BLOM Cosmetics — environment variables
# Copy to `.env` and fill in real values. Never commit a filled-in copy.
#
# VITE_* variables are inlined into the client bundle at build time and are
# therefore PUBLIC. Never put a secret behind a VITE_ prefix.
# Everything else is server-side only (Netlify Functions).

# ---------------------------------------------------------------------------
# Client (public — shipped in the browser bundle)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
VITE_N8N_BEAUTY_CLUB_WEBHOOK=https://your-n8n-host/webhook/beauty-club

# ---------------------------------------------------------------------------
# Supabase (server-side)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Bypasses row-level security. Server-side only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# PayFast (primary payment gateway)
# PAYFAST_ENV selects live vs sandbox credentials.
# ---------------------------------------------------------------------------
PAYFAST_ENV=sandbox
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
# Used to sign outgoing requests and validate incoming ITN callbacks.
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX_MERCHANT_ID=your-sandbox-merchant-id
PAYFAST_SANDBOX_MERCHANT_KEY=your-sandbox-merchant-key
PAYFAST_SANDBOX_PASSPHRASE=your-sandbox-passphrase
# Legacy alias still read as a fallback by the ITN handler.
PF_PASSPHRASE=your-payfast-passphrase
# Shared secret guarding the local ITN simulation endpoint.
TEST_ITN_SECRET=your-test-itn-secret

# ---------------------------------------------------------------------------
# Payflex (buy-now-pay-later gateway)
# ---------------------------------------------------------------------------
PAYFLEX_API_URL=https://api.payflex.example
PAYFLEX_AUTH_URL=https://auth.payflex.example/oauth/token
PAYFLEX_AUDIENCE=your-payflex-audience
PAYFLEX_CLIENT_ID=your-payflex-client-id
PAYFLEX_CLIENT_SECRET=your-payflex-client-secret
# Shared secret authorising the scheduled reconciliation function.
PAYFLEX_RECONCILE_SECRET=your-reconcile-secret

# ---------------------------------------------------------------------------
# Shipping (Shiplogic) and dispatch
# ---------------------------------------------------------------------------
SHIPLOGIC_BASE=https://api.shiplogic.example
SHIPLOGIC_TOKEN=your-shiplogic-api-token
DISPATCH_EMAIL=dispatch@example.com
DISPATCH_MOBILE=+27000000000
WAREHOUSE_ADDRESS_JSON={"street":"","city":"","code":""}

# ---------------------------------------------------------------------------
# Uber Direct (same-day local delivery)
# ---------------------------------------------------------------------------
UBER_DIRECT_CLIENT_ID=your-uber-direct-client-id
UBER_DIRECT_CLIENT_SECRET=your-uber-direct-client-secret
UBER_DIRECT_CUSTOMER_ID=your-uber-direct-customer-id
UBER_SANDBOX=true

# ---------------------------------------------------------------------------
# Storefront location (used for local-delivery radius checks)
# ---------------------------------------------------------------------------
STORE_ADDRESS=Your store address
STORE_LAT=-26.0000
STORE_LNG=28.0000
STORE_PHONE=+27000000000
STORE_RADIUS_KM=20

# ---------------------------------------------------------------------------
# n8n automation webhooks
# ---------------------------------------------------------------------------
N8N_BASE=https://your-n8n-host
N8N_ORDER_STATUS_WEBHOOK=https://your-n8n-host/webhook/order-status
N8N_REVIEW_TOKEN=your-review-webhook-token
REVIEWS_INTAKE_WEBHOOK=https://your-n8n-host/webhook/reviews-intake

# ---------------------------------------------------------------------------
# BLOM Academy (separate Supabase project — course enrolment handoff)
# ---------------------------------------------------------------------------
ACADEMY_URL=https://academy.example.com
ACADEMY_SUPABASE_URL=https://your-academy-ref.supabase.co
ACADEMY_SUPABASE_SERVICE_KEY=your-academy-service-role-key

# ---------------------------------------------------------------------------
# Site URLs (Netlify provides URL / CONTEXT automatically in deploys)
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:5173
SITE_BASE_URL=http://localhost:5173
LOCAL_ORDER_STATUS_URL=http://localhost:8888/.netlify/functions/order-status
